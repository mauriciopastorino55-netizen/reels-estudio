  "subtitles": [
    {
      "start": 0.098,
      "end": 0.723,
      "text": "En el Cántico"
    },
    {
      "start": 0.735,
      "end": 1.288,
      "text": "espiritual,"
    },
    {
      "start": 1.625,
      "end": 2.574,
      "text": "la estrofa veintitrés"
    },
    {
      "start": 2.586,
      "end": 3.583,
      "text": "introduce un giro"
    },
    {
      "start": 3.596,
      "end": 4.197,
      "text": "decisivo:"
    },
    {
      "start": 4.413,
      "end": 5.23,
      "text": "la reparación en"
    },
    {
      "start": 5.242,
      "end": 5.712,
      "text": "el huerto."
    },
    {
      "start": 6.538,
      "end": 7.26,
      "text": "Tras conjurar a"
    },
    {
      "start": 7.272,
      "end": 7.837,
      "text": "las aves,"
    },
    {
      "start": 8.101,
      "end": 8.93,
      "text": "leones y miedos"
    },
    {
      "start": 8.942,
      "end": 9.435,
      "text": "de la noche"
    },
    {
      "start": 9.447,
      "end": 9.808,
      "text": "para que la"
    },
    {
      "start": 9.82,
      "end": 10.841,
      "text": "Esposa repose en"
    },
    {
      "start": 10.853,
      "end": 11.611,
      "text": "el ameno huerto"
    },
    {
      "start": 11.623,
      "end": 12.08,
      "text": "deseado,"
    },
    {
      "start": 12.224,
      "end": 13.161,
      "text": "Pablo Jauralde Pou"
    },
    {
      "start": 13.173,
      "end": 13.978,
      "text": "señala que aquí"
    },
    {
      "start": 13.99,
      "end": 14.471,
      "text": "se quiebra el"
    },
    {
      "start": 14.483,
      "end": 15.312,
      "text": "plano profano y"
    },
    {
      "start": 15.325,
      "end": 15.973,
      "text": "se impone de"
    },
    {
      "start": 15.986,
      "end": 16.742,
      "text": "golpe la clave"
    },
    {
      "start": 16.755,
      "end": 17.416,
      "text": "religiosa."
    },
    {
      "start": 18.257,
      "end": 19.111,
      "text": "El poema dice:"
    },
    {
      "start": 19.375,
      "end": 20.325,
      "text": "debajo del manzano,"
    },
    {
      "start": 20.565,
      "end": 21.659,
      "text": "allí conmigo fuiste"
    },
    {
      "start": 21.671,
      "end": 22.26,
      "text": "desposada,"
    },
    {
      "start": 22.512,
      "end": 23.426,
      "text": "y fuiste reparada"
    },
    {
      "start": 23.438,
      "end": 24.195,
      "text": "donde tu madre"
    },
    {
      "start": 24.207,
      "end": 25.0,
      "text": "fuera violada."
    },
    {
      "start": 25.829,
      "end": 26.935,
      "text": "Como explica Disalvo,"
    },
    {
      "start": 27.248,
      "end": 28.017,
      "text": "tu madre alude"
    },
    {
      "start": 28.029,
      "end": 28.461,
      "text": "a Eva y"
    },
    {
      "start": 28.474,
      "end": 29.459,
      "text": "al pecado original"
    },
    {
      "start": 29.471,
      "end": 30.108,
      "text": "bajo el árbol"
    },
    {
      "start": 30.12,
      "end": 30.829,
      "text": "del paraíso."
    },
    {
      "start": 31.659,
      "end": 32.56,
      "text": "Al desposarse con"
    },
    {
      "start": 32.572,
      "end": 33.318,
      "text": "el alma debajo"
    },
    {
      "start": 33.329,
      "end": 34.158,
      "text": "del manzano y"
    },
    {
      "start": 34.171,
      "end": 34.843,
      "text": "darle la mano,"
    },
    {
      "start": 35.024,
      "end": 35.77,
      "text": "Cristo revierte"
    },
    {
      "start": 35.781,
      "end": 36.454,
      "text": "aquella caída"
    },
    {
      "start": 36.466,
      "end": 37.56,
      "text": "histórica y restaura"
    },
    {
      "start": 37.572,
      "end": 38.57,
      "text": "la alianza perdida"
    },
    {
      "start": 38.582,
      "end": 39.243,
      "text": "entre Dios y"
    },
    {
      "start": 39.255,
      "end": 39.904,
      "text": "la humanidad."
    },
    {
      "start": 40.745,
      "end": 41.082,
      "text": "Así,"
    },
    {
      "start": 41.406,
      "end": 42.344,
      "text": "dentro del escenario"
    },
    {
      "start": 42.356,
      "end": 42.909,
      "text": "bucólico,"
    },
    {
      "start": 43.101,
      "end": 43.798,
      "text": "el jardín deja"
    },
    {
      "start": 43.81,
      "end": 44.363,
      "text": "de ser solo"
    },
    {
      "start": 44.375,
      "end": 45.072,
      "text": "amoroso y se"
    },
    {
      "start": 45.084,
      "end": 45.697,
      "text": "revela como el"
    },
    {
      "start": 45.709,
      "end": 46.682,
      "text": "lugar exacto donde"
    },
    {
      "start": 46.695,
      "end": 47.44,
      "text": "el pecado de"
    },
    {
      "start": 47.452,
      "end": 48.51,
      "text": "Eva queda reparado."
    }
  ]
